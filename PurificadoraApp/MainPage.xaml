<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PurificadoraApp.MainPage"
             Title="Bienvenido">

    <VerticalStackLayout
        Padding="30,0"
        Spacing="25"
        VerticalOptions="Center"
        HorizontalOptions="Center">

        <Image
            Source="dotnet_bot.png"
            HeightRequest="150"
            Aspect="AspectFit"
            HorizontalOptions="Center" />

        <Label
            Text="¡Login Exitoso!"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Button
            Text="Cerrar Sesión"
            Clicked="OnLogoutClicked"
            BackgroundColor="Red"
            TextColor="White"
            HorizontalOptions="Fill" />

        <Button
            Text="Sincronizar"
            Clicked="OnSyncClicked"
            HorizontalOptions="Fill" />

    </VerticalStackLayout>
</ContentPage>