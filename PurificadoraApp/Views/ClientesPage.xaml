<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PurificadoraApp.Views.ClientesPage"
             Title="Gestión de Clientes"
             BackgroundColor="#f5f5f5">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Barra de búsqueda -->
        <Grid Grid.Row="0" Padding="10" ColumnDefinitions="*,Auto">
            <Entry x:Name="TxtBuscar" Placeholder="Buscar por nombre, apellidos o teléfono..." 
                   TextChanged="OnBuscarTextChanged"/>
            <Button x:Name="BtnBuscar" Grid.Column="1" Text="🔍" WidthRequest="50"
                    Clicked="OnBuscarClicked"/>
        </Grid>

        <!-- Botón nuevo cliente -->
        <Button x:Name="BtnNuevoCliente" Grid.Row="1" Text="+ Nuevo Cliente" 
                BackgroundColor="#27ae60" TextColor="White"
                CornerRadius="10" Margin="10" HeightRequest="50"
                Clicked="OnNuevoClienteClicked"/>

        <!-- Lista de clientes -->
        <CollectionView x:Name="ListaClientes" Grid.Row="2">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" BackgroundColor="White" Margin="5">
                        <Label Text="{Binding NombreCompleto}" FontAttributes="Bold" Grid.Row="0" Grid.Column="0"/>
                        <Label Text="{Binding Direccion}" Grid.Row="1" Grid.Column="0" FontSize="12" TextColor="Gray"/>
                        <Label Text="{Binding Telefono}" Grid.Row="2" Grid.Column="0" FontSize="12" TextColor="Gray"/>
                        <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button Text="✏️" BackgroundColor="Transparent" Clicked="OnEditarClicked" CommandParameter="{Binding .}"/>
                            <Button Text="🗑️" BackgroundColor="Transparent" TextColor="Red" Clicked="OnEliminarClicked" CommandParameter="{Binding .}"/>
                        </StackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>