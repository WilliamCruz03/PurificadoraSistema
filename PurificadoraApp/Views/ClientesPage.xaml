<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PurificadoraApp.Models"
             x:Class="PurificadoraApp.Views.ClientesPage"
             Title="Gestión de Clientes"
             BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#1a1a1a}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Barra de búsqueda -->
        <Grid Grid.Row="0" Padding="10" ColumnDefinitions="*,Auto">
            <Entry x:Name="TxtBuscar" Placeholder="Buscar por nombre, apellidos o teléfono..." 
                   TextChanged="OnBuscarTextChanged"
                   BackgroundColor="{AppThemeBinding Light=#f0f0f0, Dark=#2d2d2d}"
                   TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>
            <Button x:Name="BtnBuscar" Grid.Column="1" Text="🔍" WidthRequest="50"
                    Clicked="OnBuscarClicked" BackgroundColor="#3498db" TextColor="White"/>
        </Grid>

        <!-- Botón nuevo cliente -->
        <Button x:Name="BtnNuevoCliente" Grid.Row="1" Text="+ Nuevo Cliente" 
                BackgroundColor="#27ae60" TextColor="White"
                CornerRadius="10" Margin="10" HeightRequest="50"
                Clicked="OnNuevoClienteClicked"/>

        <!-- Lista de clientes -->
        <CollectionView x:Name="ListaClientes" Grid.Row="2">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Cliente">
                    <Grid Padding="10" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" 
                  BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2d2d2d}" Margin="5">
                        <Label Text="{Binding NombreCompleto}" FontAttributes="Bold" Grid.Row="0" Grid.Column="0"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>
                        <Label Text="{Binding Direccion}" Grid.Row="1" Grid.Column="0" FontSize="12" 
                       TextColor="{AppThemeBinding Light=Gray, Dark=#aaaaaa}"/>
                        <Label Text="{Binding Telefono}" Grid.Row="2" Grid.Column="0" FontSize="12" 
                       TextColor="{AppThemeBinding Light=Gray, Dark=#aaaaaa}"/>
                        <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button Text="✏️" BackgroundColor="Transparent" 
                            TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"
                            Clicked="OnEditarClicked" CommandParameter="{Binding .}"/>
                            <Button Text="🗑️" BackgroundColor="Transparent" TextColor="Red" 
                            Clicked="OnEliminarClicked" CommandParameter="{Binding .}"/>
                        </StackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ActivityIndicator de carga -->
        <ActivityIndicator x:Name="IndicatorCarga" Grid.RowSpan="3" IsVisible="False" IsRunning="False" 
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Color="{AppThemeBinding Light=#2c3e50, Dark=#3498db}"/>

    </Grid>
</ContentPage>