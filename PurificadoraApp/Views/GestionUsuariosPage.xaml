<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PurificadoraApp.Views.GestionUsuariosPage"
             Title="Gestión de Usuarios"
             BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#1a1a1a}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Botón para nuevo usuario -->
        <Button Grid.Row="0" Text="+ Nuevo Usuario" 
                BackgroundColor="#27ae60" TextColor="White"
                CornerRadius="10" Margin="10" HeightRequest="50"
                Clicked="OnNuevoUsuarioClicked"/>

        <!-- Lista de usuarios -->
        <CollectionView x:Name="ListaUsuarios" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" 
                          BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2d2d2d}" Margin="5">
                        <Label Text="{Binding Email}" FontAttributes="Bold" Grid.Row="0" Grid.Column="0"
                               TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>
                        <Label Text="{Binding Nombre}" Grid.Row="1" Grid.Column="0" FontSize="14" 
                               TextColor="{AppThemeBinding Light=Gray, Dark=#aaaaaa}"/>
                        <Label Text="{Binding Rol}" Grid.Row="2" Grid.Column="0" FontSize="12" TextColor="#3498db"/>
                        <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button Text="✏️" BackgroundColor="Transparent" 
                                    TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"
                                    Clicked="OnEditarClicked" CommandParameter="{Binding .}"/>
                            <Button Text="🗑️" BackgroundColor="Transparent" TextColor="Red" 
                                    Clicked="OnEliminarClicked" CommandParameter="{Binding .}"/>
                        </StackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ActivityIndicator de carga -->
        <ActivityIndicator x:Name="IndicatorCarga" Grid.RowSpan="2" IsVisible="False" IsRunning="False" 
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Color="{AppThemeBinding Light=#2c3e50, Dark=#3498db}"/>
    </Grid>
</ContentPage>