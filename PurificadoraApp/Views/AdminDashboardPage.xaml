<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PurificadoraApp.Views.AdminDashboardPage"
             Title="Dashboard Administrador"
             BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#1a1a1a}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Header con estadísticas -->
        <Grid Grid.Row="0" BackgroundColor="#2c3e50" Padding="15" ColumnDefinitions="*,*,*,*,Auto">
            <StackLayout Grid.Column="0" HorizontalOptions="Center">
                <Label x:Name="LblTotalEntregas" Text="0" TextColor="White" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="Total" TextColor="White" FontSize="12"/>
            </StackLayout>
            <StackLayout Grid.Column="1" HorizontalOptions="Center">
                <Label x:Name="LblTotalGarrafones" Text="0" TextColor="White" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="Garrafones" TextColor="White" FontSize="12"/>
            </StackLayout>
            <StackLayout Grid.Column="2" HorizontalOptions="Center">
                <Label x:Name="LblRepartidores" Text="0" TextColor="White" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="Repartidores" TextColor="White" FontSize="12"/>
            </StackLayout>
            <StackLayout Grid.Column="3" HorizontalOptions="Center">
                <Label x:Name="LblPromedioDiario" Text="0" TextColor="White" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="Promedio/Día" TextColor="White" FontSize="12"/>
            </StackLayout>
            <Button Grid.Column="4" Text="Salir" BackgroundColor="Transparent" 
                    TextColor="White" FontSize="16" VerticalOptions="Center"
                    Clicked="OnLogoutClicked"/>
        </Grid>

        <!-- Buscador rápido -->
        <SearchBar x:Name="SearchBarBuscar" Grid.Row="1" Placeholder="Buscar por cliente o repartidor..." 
                   TextChanged="OnBuscarTextoChanged" Margin="10,5,10,0"
                   BackgroundColor="{AppThemeBinding Light=#f0f0f0, Dark=#2d2d2d}"/>

        <!-- Filtros rápidos -->
        <HorizontalStackLayout Grid.Row="2" Spacing="10" Margin="10,5,10,0">
            <Button Text="Hoy" Clicked="OnFiltroHoyClicked" BackgroundColor="#3498db" TextColor="White" CornerRadius="5" HeightRequest="35"/>
            <Button Text="Semana" Clicked="OnFiltroSemanaClicked" BackgroundColor="#3498db" TextColor="White" CornerRadius="5" HeightRequest="35"/>
            <Button Text="Mes" Clicked="OnFiltroMesClicked" BackgroundColor="#3498db" TextColor="White" CornerRadius="5" HeightRequest="35"/>
            <Button Text="Todos" Clicked="OnFiltroTodosClicked" BackgroundColor="#3498db" TextColor="White" CornerRadius="5" HeightRequest="35"/>
        </HorizontalStackLayout>

        <!-- Filtros avanzados -->
        <Grid Grid.Row="2" Padding="10" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,35,0,0">
            <Picker x:Name="PickerFiltroRepartidor" Grid.Row="0" Grid.ColumnSpan="2" Title="Filtrar por repartidor" SelectedIndexChanged="OnFiltroChanged"
                    BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2d2d2d}"
                    TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>
            <Label Grid.Row="1" Grid.Column="0" Text="Desde:" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>
            <DatePicker x:Name="DateFechaInicio" Grid.Row="1" Grid.Column="0" VerticalOptions="End"/>
            <Label Grid.Row="1" Grid.Column="1" Text="Hasta:" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>
            <DatePicker x:Name="DateFechaFin" Grid.Row="1" Grid.Column="1" VerticalOptions="End"/>
        </Grid>

        <!-- Gráfico de barras - después de los filtros rápidos -->
        <VerticalStackLayout Grid.Row="3" Margin="10,5,10,10">
            <Label Text="📈 Entregas Últimos 7 Días" FontSize="14" FontAttributes="Bold" 
           TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>
            <HorizontalStackLayout x:Name="GraficoBarras" HeightRequest="150"/>
        </VerticalStackLayout>

        <!-- Lista de entregas -->
        <CollectionView x:Name="ListaEntregas" Grid.Row="4" SelectionMode="Single" SelectionChanged="OnEntregaSeleccionada">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" 
                          BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2d2d2d}" Margin="5">
                        <Label Text="{Binding ClienteNombre}" FontAttributes="Bold" FontSize="16" 
                               Grid.Row="0" Grid.Column="0"
                               TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>
                        <Label Grid.Row="1" Grid.Column="0" FontSize="14"
                               TextColor="{AppThemeBinding Light=Gray, Dark=#aaaaaa}">
                            <Label.Text>
                                <MultiBinding StringFormat="{}📦 {0} garrafones">
                                    <Binding Path="CantidadGarrafones"/>
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                        <Label Grid.Row="2" Grid.Column="0" FontSize="12"
                               TextColor="{AppThemeBinding Light=Gray, Dark=#888888}">
                            <Label.Text>
                                <MultiBinding StringFormat="{}📅 {0:dd/MM/yyyy HH:mm}">
                                    <Binding Path="FechaHoraRegistro"/>
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                        <Label Text="{Binding RepartidorNombre}" Grid.Row="0" Grid.Column="1" 
                               FontSize="12" TextColor="#3498db" VerticalOptions="Center"/>
                        <Button Text="✏️" Grid.Row="1" Grid.Column="1" BackgroundColor="Transparent" 
                                TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"
                                Clicked="OnEditarClicked" CommandParameter="{Binding .}" VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ActivityIndicator de carga -->
        <ActivityIndicator x:Name="IndicatorCarga" Grid.RowSpan="5" IsVisible="False" IsRunning="False" 
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Color="{AppThemeBinding Light=#2c3e50, Dark=#3498db}"/>

        <!-- Botones flotantes -->
        <StackLayout Grid.Row="5" Orientation="Horizontal" HorizontalOptions="End" Spacing="10" Margin="0,0,20,20">
            <Button x:Name="BtnSync" Text="🔄 Sincronizar" BackgroundColor="#2c3e50" TextColor="White" FontSize="14"
                    CornerRadius="30" WidthRequest="100" HeightRequest="50" Clicked="OnSyncClicked"/>
            <Button x:Name="BtnGestionarUsuarios" Text="👥" BackgroundColor="#3498db" TextColor="White" FontSize="20"
                    CornerRadius="30" WidthRequest="50" HeightRequest="50" Clicked="OnGestionarUsuariosClicked"/>
            <Button x:Name="BtnGestionarClientes" Text="👤" BackgroundColor="#9b59b6" TextColor="White" FontSize="20"
                    CornerRadius="30" WidthRequest="50" HeightRequest="50" Clicked="OnGestionarClientesClicked"/>
            <Button x:Name="BtnEstadisticas" Text="📊" BackgroundColor="#8e44ad" TextColor="White" FontSize="20"
                    CornerRadius="30" WidthRequest="50" HeightRequest="50" Clicked="OnEstadisticasClicked"/>
        </StackLayout>
    </Grid>
</ContentPage>