<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PurificadoraApp.Views.RepartidorPage"
             Title="Registro de Entregas"
             BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#1a1a1a}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Estado de conexión y repartidor -->
        <Grid Grid.Row="0" Padding="10" ColumnDefinitions="*,Auto,Auto" BackgroundColor="#2c3e50">
            <Label x:Name="LblRepartidorNombre" Text="Cargando..." TextColor="White" VerticalOptions="Center"/>
            <Button Grid.Column="1" Text="🔄" BackgroundColor="Transparent" 
                    TextColor="White" FontSize="18" Clicked="OnSyncManualClicked"
                    IsVisible="{Binding IsConnected}"/>
            <Button Grid.Column="2" Text="🚪" BackgroundColor="Transparent" 
                    TextColor="White" FontSize="18" Clicked="OnLogoutClicked"/>
            <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Image x:Name="ImgConexion" Source="cloud_off.png" HeightRequest="20"/>
                <Label x:Name="LblEstadoConexion" Text="Sin conexión" TextColor="Red"/>
            </StackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label Text="Nueva Entrega" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#2c3e50, Dark=#ffffff}"/>

                <!-- Buscador de clientes -->
                <Label Text="Buscar Cliente" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>
                <SearchBar x:Name="SearchBarClientes" 
                           Placeholder="Buscar cliente por nombre o teléfono..."
                           TextChanged="OnBuscarClienteChanged"
                           BackgroundColor="{AppThemeBinding Light=#f0f0f0, Dark=#2d2d2d}"/>

                <!-- Lista de resultados de clientes -->
                <CollectionView x:Name="ListaClientesResultados" 
                                HeightRequest="200"
                                IsVisible="False"
                                SelectionMode="Single"
                                SelectionChanged="OnClienteSeleccionado">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10" BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2d2d2d}" Margin="0,2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding NombreCompleto}" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>
                                        <Label Text="{Binding Direccion}" FontSize="12" 
                                               TextColor="{AppThemeBinding Light=Gray, Dark=#aaaaaa}"/>
                                        <Label Text="{Binding Telefono}" FontSize="12" 
                                               TextColor="{AppThemeBinding Light=Gray, Dark=#aaaaaa}"/>
                                    </VerticalStackLayout>
                                    <Label Text="➡️" Grid.Column="1" VerticalOptions="Center" FontSize="20"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Cliente seleccionado -->
                <Frame x:Name="FrameClienteSeleccionado" BorderColor="#27ae60" CornerRadius="10" IsVisible="False"
                       BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2d2d2d}">
                    <VerticalStackLayout>
                        <Label Text="Cliente Seleccionado" FontAttributes="Bold" TextColor="#27ae60"/>
                        <Label x:Name="LblClienteSeleccionado" FontSize="16"
                               TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>
                        <Label x:Name="LblDireccionSeleccionada" FontSize="14" 
                               TextColor="{AppThemeBinding Light=Gray, Dark=#aaaaaa}"/>
                        <Button Text="Cambiar Cliente" Clicked="OnCambiarCliente" BackgroundColor="Gray" TextColor="White"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Cantidad de garrafones -->
                <Entry x:Name="TxtCantidad" 
                       Placeholder="Cantidad de garrafones" 
                       PlaceholderColor="Gray"
                       Keyboard="Numeric"
                       BackgroundColor="{AppThemeBinding Light=#f0f0f0, Dark=#2d2d2d}"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>

                <!-- Botón Registrar -->
                <Button x:Name="BtnRegistrar" 
                        Text="Registrar Entrega" 
                        BackgroundColor="#27ae60"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="50"
                        IsEnabled="False"
                        Clicked="OnRegistrarClicked"/>

                <!-- Botón Sincronizar -->
                <Button x:Name="BtnSincronizar" 
                        Text="Sincronizar Entregas" 
                        BackgroundColor="#3498db"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnSincronizarClicked"/>

                <!-- Lista de entregas pendientes -->
                <Label Text="Entregas Pendientes de Sincronizar" 
                       FontSize="16" 
                       FontAttributes="Bold"
                       Margin="0,20,0,5"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>

                <CollectionView x:Name="ListaPendientes" 
                                HeightRequest="250">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" 
                                  BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#2d2d2d}" Margin="5">
                                <Label Text="{Binding ClienteNombre}" FontAttributes="Bold" Grid.Row="0" Grid.Column="0"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#ffffff}"/>
                                <Label Grid.Row="1" Grid.Column="0" FontSize="12" 
                                       TextColor="{AppThemeBinding Light=Gray, Dark=#aaaaaa}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} garrafones - {1}">
                                            <Binding Path="CantidadGarrafones"/>
                                            <Binding Path="Direccion"/>
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <Label Text="⏳" Grid.Row="0" Grid.Column="1" FontSize="20"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ActivityIndicator de carga - Agregar esto al final del Grid, antes de </Grid> -->
        <ActivityIndicator x:Name="IndicatorCarga" Grid.RowSpan="3" IsVisible="False" IsRunning="False" 
                   HorizontalOptions="Center" VerticalOptions="Center"
                   Color="{AppThemeBinding Light=#2c3e50, Dark=#3498db}"/>
    </Grid>
</ContentPage>